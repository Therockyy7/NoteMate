{
  "expo": {
    "name": "NoteMate",
    "slug": "NoteMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoNoteMate.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "NoteMate",
    "deepLinks": ["Notemate://success-payment"],
    "splash": {
      "image": "./assets/logoNoteMate.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoNoteMate.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logoNoteMate.png"
    },
    "plugins": ["expo-audio", "expo-router"]
  }
}
